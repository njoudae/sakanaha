{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "VITE_APP_ENV",
    "VITE_APP_RELEASE",
    "VITE_CONVEX_URL",
    "VITE_ENABLE_DEVELOPMENT_ADMIN",
    "VITE_FEATURE_ANALYTICS_POSTHOG_ENABLED",
    "VITE_FEATURE_AUTH_CONVEX_AUTH_ENABLED",
    "VITE_FEATURE_AUTH_EMAIL_OTP_ENABLED",
    "VITE_FEATURE_AUTH_GOOGLE_ENABLED",
    "VITE_FEATURE_AUTH_PHONE_OTP_ENABLED",
    "VITE_FEATURE_DATA_CONVEX_ENABLED",
    "VITE_FEATURE_DATA_DUAL_READ_ENABLED",
    "VITE_FEATURE_DATA_DUAL_WRITE_ENABLED",
    "VITE_FEATURE_MAPS_UNIVERSITY_DIRECTIONS_ENABLED",
    "VITE_FEATURE_MONITORING_SENTRY_ENABLED",
    "VITE_FEATURE_PERFORMANCE_WEB_VITALS_ENABLED",
    "VITE_POSTHOG_HOST",
    "VITE_POSTHOG_KEY",
    "VITE_SENTRY_DSN",
    "VITE_SENTRY_TRACES_SAMPLE_RATE",
    "VITE_WEB_VITALS_SAMPLE_RATE",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ],
  "globalPassThroughEnv": ["CONVEX_DEPLOY_KEY", "SENTRY_AUTH_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["node_modules/.tmp/*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
